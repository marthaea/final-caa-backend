  "description": "Thin npm wrappers around the Java/Maven PostgreSQL seed commands",
  "scripts": {
    "seed": "SEED_MODE=all SEED_DEMO=true SEED_DEMO_VOLUME=false ./scripts/seed.sh all",
    "seed:core": "SEED_DEMO=true ./scripts/seed.sh core",
    "seed:demo": "SEED_DEMO=true ./scripts/seed.sh demo",
    "seed:volume": "SEED_DEMO=true SEED_DEMO_VOLUME=true ./scripts/seed.sh volume",
    "seed:all": "SEED_DEMO=true SEED_DEMO_VOLUME=true ./scripts/seed.sh all"
  }
}
