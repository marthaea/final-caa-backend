# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/caa_recruitment
DB_USERNAME=caa
DB_PASSWORD=caa
DB_POOL_SIZE=20

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_32_byte_random_string
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_random_string

# Refresh cookie
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# ── Cloudinary (optional; without credentials photos store under ./uploads) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (leave SMTP_ENABLED=false to keep outbox undelivered) ────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=CAA HR Team

# ── Server ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
OPENAPI_ENABLED=true
